# encoding: utf-8
# 2026 R1
SetScriptVersion(Version="26.1.174")
system1 = GetSystem(Name="SYS")
modelComponent1 = system1.GetComponent(Name="Model")
modelComponent1.Refresh()
model1 = system1.GetContainer(ComponentName="Model")
model1.Edit()
model1.Exit()
geometry1 = system1.GetContainer(ComponentName="Geometry")
geometry1.Edit(IsDiscoveryGeometry=True)
geometry1.Exit()
modelComponent1.Refresh()
model1.Edit()
geometry1.Edit(IsDiscoveryGeometry=True)
geometry1.Exit()
parameter1 = Parameters.GetParameter(Name="P1")
parameter1.DisplayText = "Fillet radius"
parameter1.SetQuantityUnit(Unit="mm")
designPoint1 = Parameters.CreateDesignPoint()
designPoint1.SetParameterExpression(
    Parameter=parameter1,
    Expression="1 [mm]")
designPoint2 = Parameters.CreateDesignPoint()
designPoint2.SetParameterExpression(
    Parameter=parameter1,
    Expression="3 [mm]")
designPoint3 = Parameters.CreateDesignPoint()
designPoint3.SetParameterExpression(
    Parameter=parameter1,
    Expression="4 [mm]")
designPoint4 = Parameters.CreateDesignPoint()
designPoint4.SetParameterExpression(
    Parameter=parameter1,
    Expression="5 [mm]")
designPoint5 = Parameters.GetDesignPoint(Name="0")
backgroundSession1 = UpdateAllDesignPoints(DesignPoints=[designPoint5, designPoint1, designPoint2, designPoint3, designPoint4])
Save(Overwrite=True)
Save(Overwrite=True)
